{
  "profiles": {
    "preview-local": {
      "description": "Preview build; API base is the local Compose gateway address (nothing listens there during a run).",
      "env": {
        "VITE_API_BASE_URL": "http://localhost:28080"
      }
    },
    "preview-same-origin": {
      "description": "Preview build with an empty API base, so API calls go to the page origin.",
      "env": {
        "VITE_API_BASE_URL": ""
      }
    },
    "preview-chat": {
      "description": "preview-local plus the member chat flag.",
      "env": {
        "VITE_API_BASE_URL": "http://localhost:28080",
        "VITE_MEMBER_CHAT_ENABLED": "true"
      }
    },
    "dev-local": {
      "description": "Dev server; API base is the local Compose gateway address.",
      "env": {
        "VITE_API_BASE_URL": "http://localhost:28080"
      }

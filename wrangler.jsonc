{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pawbridge-frontend",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "prod"
  },
  "env": {
    "dev": {
      "name": "pawbridge-frontend-dev",
      "routes": [],
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "dev"
      },
      "assets": {
        "directory": "./dist/dev",
        "binding": "ASSETS"
      }
    },
    "prod": {
      "name": "pawbridge-frontend",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "prod"
      },
      "assets": {
        "directory": "./dist/prod",
        "binding": "ASSETS"
      }
    }
  }
}

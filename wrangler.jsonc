{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pawbridge-frontend",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-19",
  // CSP 위반 보고 요약(worker/cspReport.ts)을 Workers Logs에서 보기 위해 켠다.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "prod"
  },
  "env": {
    "prod": {
      "name": "pawbridge-frontend",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "prod"
      },
      "assets": {
        "directory": "./dist/prod",
        "binding": "ASSETS"
      }
    }
  }
}

{
  "name": "pawbridge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test:lint-policy": "node --test-isolation=none --test tests/lint-policy.test.mjs",
    "preview": "vite preview",
    "test:seo": "node --experimental-strip-types --test tests/seo.test.ts",
    "test:stats": "node --experimental-strip-types --test tests/regionalStats.test.ts tests/animalStatistics.test.ts",
    "test:visits": "node --experimental-strip-types --test-isolation=none --test tests/visits.test.ts",
    "test:chat": "node --experimental-strip-types --test-isolation=none --test tests/member-chat.test.ts tests/chat-ticket.test.ts tests/noteStreamClient.test.ts",
    "build:dev": "node scripts/build-environment.mjs dev",
    "build:prod": "node scripts/build-environment.mjs prod",
    "test:environment": "node --test tests/environment-policy.test.mjs",
    "test:icons": "node --test tests/icon-subset.test.mjs",
    "test:unit": "node --experimental-strip-types --test-isolation=none --test tests/adminStatistics.test.ts tests/animalDisplay.test.ts tests/animalSearch.test.ts tests/apiError.test.ts tests/authSession.test.ts tests/blockedAuthorCache.test.mjs tests/dependency-security.test.mjs tests/homeVideos.test.ts tests/mapDependencySecurity.test.mjs tests/noteNotificationWindow.test.ts tests/privateNoteStream.test.ts tests/reportNavigation.test.ts tests/reportSearch.test.ts tests/sessionRefresh.test.ts tests/shelterDetail.test.ts tests/shelterDiscovery.test.ts tests/shelters.test.ts tests/travel.test.ts",
    "dev:local": "node scripts/start-local.mjs",
    "test:browser": "node tests/run-browser.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "7.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tosspayments/payment-sdk": "^1.9.2",
    "axios": "1.20.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "7.18.4",
    "react-simple-maps": "5.0.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.49.0",
    "vite": "7.3.6",
    "wrangler": "4.149.0"
  }
}
